# Copy to pi/.env on the Pi and fill in. NEVER commit pi/.env.

# Deepgram REST API key (same one used by the PC app)
DEEPGRAM_API_KEY=

# Default transcription language (BCP-47). User can override per-job in the UI.
DEFAULT_LANGUAGE=pt-BR

# How many downloads run in parallel. Pi 4 ffmpeg is CPU-bound; 2 is sane.
MAX_CONCURRENT_JOBS=2

# How many finished jobs we keep visible in the UI before pruning the oldest.
JOB_HISTORY_LIMIT=50

# Host path mapped into the container as /output. Must be a folder that
# Syncthing on the Pi watches and shares with the PC.
OUTPUT_DIR=/media/devmon/sda1-ata-UP_GAMER_1TB_UP2/Syncthing/videos-app

# Host port the UI binds to. Tailscale Serve in front of this gives HTTPS
# inside the tailnet.
HOST_PORT=8080
